        "jsCode": "// Only the configured admin chat may act. Button data is \"pub:<uuid>\" or \"rej:<uuid>\".\nconst ADMIN_CHAT_ID = '__ADMIN_CHAT_ID__';\nconst q = $json.callback_query;\nif (!q) return [];\nconst chatId = String(q.message?.chat?.id ?? '');\nconst m = /^(pub|rej):([0-9a-f-]{36})$/.exec(String(q.data || ''));\nreturn [{ json: { query_id: q.id, chat_id: chatId, message_id: q.message?.message_id ?? null,\n  actor: 'telegram:' + String(q.from?.id ?? 'unknown'), allowed: chatId === ADMIN_CHAT_ID && !!m,\n  action: m ? m[1] : null, property_id: m ? m[2] : null } }];"
      },
