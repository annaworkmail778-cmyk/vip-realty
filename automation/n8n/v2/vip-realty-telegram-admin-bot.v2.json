    {
      "parameters": {
        "jsCode": "const __out = [];\nconst __items = $input.all();\nfor (let __k = 0; __k < __items.length; __k++) {\n  const $json = __items[__k].json;\n  const __r = (() => {\n    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n    const SITE = 'https://vip-realty.netlify.app';\n    const p = $('Load listing state').first().json;\n    const r = $json || {};\n    const BLOCKERS = { missing_title: 'վերնագիր', missing_intent: 'վաճառք/վարձ', missing_property_type: 'գույքի տեսակ',\n      missing_city: 'քաղաք', missing_price: 'գին', missing_currency: 'արժույթ', not_approved: 'հաստատված չէ',\n      media_processing: 'նկարները դեռ մշակվում են', extraction_not_valid: 'տվյալների ճանաչումը վավեր չէ',\n      unresolved_conflict: 'հակասական տվյալներ', agent_inactive: 'գործակալը ակտիվ չէ', agency_inactive: 'գործակալությունը ակտիվ չէ',\n      archived: 'արխիվացված է', database_guard: 'բազայի ստուգումը չանցավ' };\n    let text;\n    if (r.outcome === 'published') text = `✅ <b>Հրապարակված է</b>\\n${SITE}/properties/${esc(r.slug || p.slug)}`;\n    else if (r.outcome === 'already' && r.slug) text = `ℹ️ Արդեն հրապարակված է\\n${SITE}/properties/${esc(r.slug)}`;\n    else if (r.outcome === 'rejected' || (r.outcome === 'already' && r.review_status === 'rejected')) text = '❌ <b>Մերժված է</b>։ Կայքում չի երևա։';\n    else if (r.outcome === 'blocked') text = '⛔ <b>Չհաջողվեց հրապարակել</b>։ Լրացրեք՝ ' + esc((r.blockers || []).map((b) => BLOCKERS[b] || b).join(', ')) + '\\n«Խմբագրել» կոճակով ուղղեք և նորից սեղմեք ✅։';\n    else if (r.outcome === 'stale') text = '🔄 Հայտարարությունը հենց նոր փոփոխվել է։ Սեղմեք կոճակը կրկին։';\n    else if (r.outcome === 'invalid_state') text = 'ℹ️ Այս հայտարարությունն այլևս draft չէ (' + esc(r.listing_status || p.listing_status) + ')։';\n    else text = '⚠️ Գործողությունը չկատարվեց (' + esc(r.outcome || r.reason || r.message || 'error') + ')։';\n    return [{ json: { text, toast: text.replace(/<[^>]+>/g, '').split('\\n')[0].slice(0, 190) } }];\n  })();\n  for (const x of (__r || [])) __out.push(x);\n}\nreturn __out;"
      },
