      "parameters": {
        "jsCode": "// Runs once for all items; each input item is processed in turn (same logic as per-item).\nconst __out = [];\nconst __items = $input.all();\nfor (let __k = 0; __k < __items.length; __k++) {\n  const $json = __items[__k].json;\n  const __r = (() => {\n    const p = $('Needs city?').all()[__k].json;\n    const r = $json || {};\n    return [{ json: { ...p, city: (r.ok && ['updated', 'unchanged'].includes(r.outcome)) ? 'Yerevan' : p.city } }];\n  })();\n  for (const x of (__r || [])) __out.push(x);\n}\nreturn __out;"
