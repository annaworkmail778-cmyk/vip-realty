    {
      "parameters": {
        "jsCode": "// Runs once for all items; each input item is processed in turn (same logic as per-item).\nconst __out = [];\nconst __items = $input.all();\nfor (let __k = 0; __k < __items.length; __k++) {\n  const $json = __items[__k].json;\n  const __r = (() => {\n    // The extraction prompt never derives the city from a district. For the twelve\n    // administrative districts of Yerevan the city is certain, so it is filled in (through the\n    // audited admin_update_property path) instead of blocking publication with \"missing city\".\n    const YEREVAN = ['ajapnyak','arabkir','avan','davtashen','erebuni','kanaker-zeytun','kentron','malatia-sebastia',\n                     'nor-nork','nork-marash','nubarashen','shengavit'];\n    const p = $json;\n    const d = String(p.district || '').toLowerCase().trim().replace(/[\\s_]+/g, '-');\n    return [{ json: { ...p, needs_city: !p.city && YEREVAN.includes(d) } }];\n  })();\n  for (const x of (__r || [])) __out.push(x);\n}\nreturn __out;"
      },
