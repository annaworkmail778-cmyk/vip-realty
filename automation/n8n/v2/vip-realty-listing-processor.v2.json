    {
      "parameters": {
        "jsCode": "// Runs once for all items; each input item is processed in turn (same logic as per-item).\nconst __out = [];\nconst __items = $input.all();\nfor (let __k = 0; __k < __items.length; __k++) {\n  const $json = __items[__k].json;\n  const __r = (() => {\n    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n    const p = $json;\n    if (!p || !p.id) return [];\n    const SB = 'https://vqdxqqsvlkddgkzulaxv.supabase.co', SITE = 'https://vip-realty.netlify.app';\n    const imgs = (p.property_images || []).slice().sort((a, b) => (b.is_primary - a.is_primary) || (a.sort_order - b.sort_order));\n    const deal = p.intent === 'rent' ? 'Վարձակալություն' : p.intent === 'buy' ? 'Վաճառք' : '—';\n    const price = p.price ? Number(p.price).toLocaleString('en-US') + ' ' + (p.currency || '') + (p.price_period === 'month' ? ' / ամիս' : '') : '—';\n    const facts = [p.rooms ? p.rooms + ' սենյակ' : null, p.area_sqm ? Number(p.area_sqm) + ' քմ' : null,\n                   p.floor ? p.floor + (p.total_floors ? '/' + p.total_floors : '') + ' հարկ' : null].filter(Boolean).join(' · ');\n    const place = [p.district, p.city].filter(Boolean).join(', ') || '—';\n    const missing = [['title', 'վերնագիր'], ['intent', 'վաճառք/վարձ'], ['property_type', 'գույքի տեսակ'], ['city', 'քաղաք'],\n                     ['price', 'գին'], ['currency', 'արժույթ']].filter(([k]) => p[k] == null || p[k] === '').map(([, l]) => l);\n    const ag = p.agents || null;\n    const agentLine = ag ? `👤 ${esc(ag.name)}${ag.phone || ag.whatsapp_phone ? ' · ' + esc(ag.phone || ag.whatsapp_phone) : ' · ⚠️ հեռախոս չկա (կայքում կերևա գործակալության համարը)'}` : '👤 —';\n    const desc = String(p.description || '').slice(0, 350);\n    let caption = `🏠 <b>Նոր հայտարարություն՝ հաստատման համար</b>\\n\\n<b>${esc(deal)}</b> · ${esc(price)}\\n📍 ${esc(place)}\\n${esc(facts)}\\n📷 ${imgs.length} լուսանկար\\n${agentLine}`;\n    if (missing.length) caption += `\\n\\n⚠️ <b>Լրացնել մինչև հրապարակումը՝</b> ${esc(missing.join(', '))} («Խմբագրել»)`;\n    if (desc) caption += `\\n\\n${esc(desc)}${String(p.description || '').length > 350 ? '…' : ''}`;\n    caption = caption.slice(0, 1000);\n    const cover = imgs[0] ? SB + '/storage/v1/object/public/property-images/' + imgs[0].storage_path.split('/').map(encodeURIComponent).join('/') : null;\n    return [{ json: { property_id: p.id, caption, photo_url: cover, admin_url: SITE + '/admin/properties/' + p.id, edit_url: SITE + '/admin/properties/' + p.id + '/edit' } }];\n  })();\n  for (const x of (__r || [])) __out.push(x);\n}\nreturn __out;"
      },
