# VIP Realty — environment variables (names only; never put real values in this file or in Git).
# Copy to .env.local for local development. In production set them in the hosting platform.
# Check with:  npm run check:config            (development)
#              npm run check:config:production (release gate — exits 1 on missing/unsafe settings)

# ---- Browser-safe (bundled into client code) --------------------------------
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# ---- Server-only (never NEXT_PUBLIC_) ---------------------------------------
# Publishable (anon) key: RLS-limited public listing reads and "request more information".
# Supabase dashboard → Project Settings → API keys → publishable key.
SUPABASE_PUBLISHABLE_KEY=

# ---- Server-only secrets ----------------------------------------------------
# Service-role / secret key: admin area only (drafts, review, publish). Same project as the URL above.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in. Production requires ADMIN_PASSWORD_HASH (npm run admin:hash-password) and a random
# ADMIN_SESSION_SECRET of 32+ characters. Rotating either value signs every admin out.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local development only (ignored in production): plaintext admin password.
ADMIN_PASSWORD=

# ---- Not used by the website ------------------------------------------------
# WhatsApp / Meta, Anthropic and the Supabase service key used by automation live in n8n credential
# storage, referenced by name (see automation/n8n/README.md). They never belong in this file.
# Optional, for `npm run check:config -- --n8n` only (an n8n API key; keep out of Git):
# N8N_API_URL=
# N8N_API_KEY=
