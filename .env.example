# Copy to .env.local and fill in. See README.md → "Configuration".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public listing reads and "request more information" submissions
# (server-side only, RLS-protected).
# Supabase dashboard → Project Settings → API keys → publishable key (or the legacy anon key).
SUPABASE_PUBLISHABLE_KEY=

# Admin listing management only (reads unpublished listings). Server-side only;
# never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Admin sign-in. Use a long random password and a random 32+ character secret
# before any deployment.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
