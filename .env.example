# Copy to .env.local and fill in. See README.md → "Booking system setup".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public listing reads (server-side only, RLS-protected).
# Supabase dashboard → Project Settings → API keys → publishable key (or the legacy anon key).
SUPABASE_PUBLISHABLE_KEY=

# Booking system only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
